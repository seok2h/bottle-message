# 백엔드 환경변수 예시 — 복사해서 .env 로 사용
# cp .env.example .env   (Windows: Copy-Item .env.example .env)

# 서버 포트
PORT=4000

# 프론트엔드 주소 (CORS 허용 대상). 쉼표로 여러 개 가능.
CORS_ORIGIN=http://localhost:5173

# 데이터베이스 접속 (택1)
# (A) 로컬 Docker — 아래 개별 값 사용 (DATABASE_URL 비워두면 이 값들이 쓰임)
PGHOST=localhost
PGPORT=5432
PGUSER=bottle
PGPASSWORD=bottle_dev_pw
PGDATABASE=bottle

# (B) 배포(Neon 등) — 연결 문자열 하나로. 설정되면 위 개별 값보다 우선.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
